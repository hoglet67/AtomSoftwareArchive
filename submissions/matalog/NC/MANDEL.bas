  5 REM MANDELBROT SET
  6 REM BY MATALOG
 10 CLEAR 4
 20 I=20
 30 FOR B=0 TO 95
 35 %V=B/95-1
 40 FOR A=0 TO 255
 50 %H=A/95-2
 70 %X=%H
 80 %Y=%V
 90 Q=0
 95 %G=%X*%X
 96 %D=%Y*%Y
100 %W=%G-%D
120 FIF (%G+%D)>4 GOTO 180
130 IF Q>I GOTO 170
135 %Y=2*%X*%Y+%V
140 %X=%W+%H
150 Q=Q+1
160 GOTO 95
170 PLOT 13,A,B
175 IF B>95 GOTO 180
176 PLOT 13,A,(190-B)
180 NEXT A
190 NEXT B
200 LINK #FFE3
210 END
